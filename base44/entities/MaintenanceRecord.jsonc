{
  "name": "MaintenanceRecord",
  "type": "object",
  "properties": {
    "equipment_id": {
      "type": "string"
    },
    "equipment_name": {
      "type": "string"
    },
    "service_date": {
      "type": "string",
      "format": "date"
    },
    "next_service_date": {
      "type": "string",
      "format": "date"
    },
    "technician": {
      "type": "string"
    },
    "service_cost": {
      "type": "number"
    },
    "service_notes": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "Routine",
        "Repair",
        "Emergency",
        "Inspection"
      ],
      "default": "Routine"
    },
    "status": {
      "type": "string",
      "enum": [
        "Scheduled",
        "In Progress",
        "Completed"
      ],
      "default": "Scheduled"
    }
  },
  "required": [
    "equipment_id",
    "service_date"
  ]
}