{
  "name": "RentalInvoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_vat_number": {
      "type": "string"
    },
    "billing_address": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "booking_number": {
      "type": "string"
    },
    "machine_hour_log_id": {
      "type": "string"
    },
    "machine_hour_log_number": {
      "type": "string"
    },
    "items": {
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "vat_rate": {
      "type": "number",
      "default": 15
    },
    "vat_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "outstanding": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Issued",
        "Sent",
        "Partially Paid",
        "Paid",
        "Overdue",
        "Cancelled"
      ],
      "default": "Draft"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    },
    "terms": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "invoice_number",
    "customer_id",
    "total"
  ]
}