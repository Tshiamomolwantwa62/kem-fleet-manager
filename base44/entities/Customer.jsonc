{
  "name": "Customer",
  "type": "object",
  "properties": {
    "customer_type": {
      "type": "string",
      "enum": [
        "Company",
        "Individual"
      ]
    },
    "company_name": {
      "type": "string"
    },
    "registration_number": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "id_number": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Blacklisted",
        "Inactive"
      ],
      "default": "Active"
    },
    "notes": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "customer_type",
    "email",
    "phone"
  ]
}