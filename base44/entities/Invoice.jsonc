{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "items": {
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "vat_amount": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent",
        "Paid",
        "Overdue",
        "Cancelled"
      ],
      "default": "Draft"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "Invoice",
        "Quotation"
      ],
      "default": "Invoice"
    }
  },
  "required": [
    "invoice_number",
    "customer_id",
    "total"
  ]
}