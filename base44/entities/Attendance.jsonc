{
  "name": "Attendance",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "clock_in": {
      "type": "string"
    },
    "clock_out": {
      "type": "string"
    },
    "total_hours": {
      "type": "number",
      "default": 0
    },
    "break_duration": {
      "type": "number",
      "default": 0
    },
    "overtime": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Present",
        "Absent",
        "Late",
        "On Leave",
        "Half Day",
        "Remote",
        "Holiday"
      ],
      "default": "Present"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "date"
  ]
}