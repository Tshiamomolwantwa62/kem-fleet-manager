{
  "name": "GalleryImage",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "alt_text": {
      "type": "string"
    },
    "seo_description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Plant Hire",
        "Construction Projects",
        "Road Works",
        "Civil Engineering",
        "Property Maintenance",
        "Before & After",
        "Company Events"
      ],
      "default": "Plant Hire"
    },
    "album": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "image_url"
  ]
}